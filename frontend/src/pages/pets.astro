---
// MascoLive — Directorio de mascotas (SSG). Filtros por clínica/tipo en el cliente.
import { graphql } from '../lib/api';
const { pets, clinics, error } = await graphql('{ pets { id title petType clinic { id title } } clinics { id title } }');
const tipos = [...new Set(pets.map((p) => p.petType ?? '').filter(Boolean))];
// Los datos se incrustan como JSON; el < is:inline > protege de un cierre prematuro.
const data = JSON.stringify(
  pets.map((p) => ({
    id: p.id,
    title: p.title,
    petType: p.petType ?? '',
    clinicId: p.clinic?.id ?? '',
    clinicTitle: p.clinic?.title ?? '',
  }))
).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mascotas MascoLive</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 720px; margin: 0 auto; padding: 2rem 1rem; color: #222; line-height: 1.5; }
      h1 { margin-top: 0; }
      nav.roles { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
      nav.roles a { text-decoration: none; padding: .35rem .7rem; border: 1px solid #146a4d; border-radius: 20px; color: #146a4d; font-size: .85rem; }
      nav.roles a.active { background: #146a4d; color: #fff; }
      .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem 1.2rem; margin-bottom: 1.5rem; }
      ul { padding-left: 1.2rem; }
      li { margin-bottom: .5rem; }
      .clinic { color: #666; }
      .error { color: #b00020; border: 1px solid #b00020; padding: 1rem; border-radius: 4px; }
      a.web { display: inline-block; margin-top: .5rem; color: #146a4d; }
      .badge { display: inline-block; border: 1px solid #146a4d; border-radius: 20px; padding: .1rem .6rem; color: #146a4d; font-size: .85rem; }
      select { margin-right: .75rem; padding: .3rem .5rem; }
    </style>
  </head>
  <body>
    <h1>Mascotas MascoLive</h1>
    <nav class="roles">
      <a href="/publico">Público</a>
      <a href="/tutor">Tutor</a>
      <a href="/veterinario">Veterinario</a>
      <a href="/admin">Admin</a>
      <a href="/clinicas">Clínicas</a>
      <a class="active" href="/pets">Mascotas</a>
    </nav>

    {error && <p class="error">{error}</p>}

    <div class="card">
      <p><strong>{pets.length} mascotas</strong> — filtra por clínica o tipo:</p>
      <select id="clinic-filter">
        <option value="">Todas las clínicas</option>
        {clinics.map((c) => (
          <option value={c.id}>{c.title}</option>
        ))}
      </select>
      <select id="type-filter">
        <option value="">Todos los tipos</option>
        {tipos.map((t) => (
          <option value={t}>{t}</option>
        ))}
      </select>
    </div>

    <ul id="pets-list"></ul>

    <script is:inline type="application/json" id="pets-data">{data}</script>
    <script is:inline>
      const data = JSON.parse(document.getElementById('pets-data').textContent);
      const list = document.getElementById('pets-list');
      const esc = (s) =>
        String(s ?? '').replace(/[&<>"']/g, (ch) => (
          { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]
        ));
      const li = (p) =>
        '<li' +
        (p.clinicId ? ` data-clinic="${esc(p.clinicId)}"` : '') +
        (p.petType ? ` data-type="${esc(p.petType)}"` : '') +
        '><strong>' + esc(p.title) + '</strong>' +
        ' <span class="clinic">— ' + esc(p.clinicTitle || 'sin clínica') + '</span>' +
        (p.petType ? ' <span class="badge">🐾 ' + esc(p.petType) + '</span>' : '') +
        '</li>';
      list.innerHTML = data.map(li).join('');
      const clinicSel = document.getElementById('clinic-filter');
      const typeSel = document.getElementById('type-filter');
      function applyFilter() {
        const c = clinicSel.value;
        const t = typeSel.value;
        document.querySelectorAll('#pets-list li').forEach((item) => {
          item.hidden = (c && item.dataset.clinic !== c) || (t && item.dataset.type !== t);
        });
      }
      clinicSel.addEventListener('change', applyFilter);
      typeSel.addEventListener('change', applyFilter);
    </script>
  </body>
</html>