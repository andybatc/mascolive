---
// MascoLive — Detalle de clínica (SSG).
import { graphql } from '../../lib/api';

export async function getStaticPaths() {
  const { clinics } = await graphql('{ clinics { id } }');
  return clinics.map((c) => ({ params: { id: String(c.id) } }));
}

const { id } = Astro.params;
const { clinics, error } = await graphql('{ clinics { id title address specialty pets { id title } } }');
const clinic = clinics.find((c) => String(c.id) === String(id));
const mascotas = clinic?.pets ?? [];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{clinic ? `${clinic.title} — MascoLive` : 'Clínica no encontrada — MascoLive'}</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 720px; margin: 0 auto; padding: 2rem 1rem; color: #222; line-height: 1.5; }
      h1 { margin-top: 0; }
      nav.roles { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
      nav.roles a { text-decoration: none; padding: .35rem .7rem; border: 1px solid #146a4d; border-radius: 20px; color: #146a4d; font-size: .85rem; }
      nav.roles a.active { background: #146a4d; color: #fff; }
      .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem 1.2rem; margin-bottom: 1.5rem; }
      ul { padding-left: 1.2rem; }
      li { margin-bottom: .5rem; }
      .clinic { color: #666; }
      .error { color: #b00020; border: 1px solid #b00020; padding: 1rem; border-radius: 4px; }
      a.web { display: inline-block; margin-top: .5rem; color: #146a4d; }
    </style>
  </head>
  <body>
    <h1>MascoLive — Detalle de clínica</h1>
    <nav class="roles">
      <a href="/publico">Público</a>
      <a href="/tutor">Tutor</a>
      <a href="/veterinario">Veterinario</a>
      <a href="/admin">Admin</a>
      <a href="/pets">Mascotas</a>
      <a class="active" href="/clinicas">Clínicas</a>
    </nav>

    {error && <p class="error">{error}</p>}

    {!clinic && (
      <div class="card">
        <p>No se encontró la clínica <strong>{id}</strong>.</p>
        <a class="web" href="/clinicas">← Volver al listado</a>
      </div>
    )}

    {clinic && (
      <div class="card">
        <h2>{clinic.title}</h2>
        <p><strong>Dirección:</strong> {clinic.address || '—'}</p>
        <p><strong>Especialidad:</strong> {clinic.specialty || '—'}</p>
        <h3>Mascotas en esta clínica ({mascotas.length})</h3>
        {mascotas.length === 0 && <p class="clinic">Sin mascotas registradas.</p>}
        <ul>
          {mascotas.map((p) => (
            <li><a class="web" href={`/pets/${p.id}`}>{p.title}</a></li>
          ))}
        </ul>
        <a class="web" href="/clinicas">← Volver al listado</a>
      </div>
    )}
  </body>
</html>